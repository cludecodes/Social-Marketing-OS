# --- General ---
APP_ENV=development
SECRET_KEY=dev-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
DATABASE_URL=sqlite:///storage/data/shophippy.db

# --- Auth (change before production) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Timezone / automation ---
TIMEZONE=Asia/Karachi
AUTOMATION_ENABLED=true
AUTONOMOUS_PUBLISHING=false
AUTO_CONTENT_GENERATION=true
AUTO_SCHEDULING=true
AUTO_COMMUNITY_RESPONSES=false
REQUIRE_APPROVAL=true
MAX_DAILY_POSTS=6
QA_MIN_SCORE=80
MAX_JOB_ATTEMPTS=3

# --- Automation schedule (PKT) ---
SCHED_RESEARCH=06:00
SCHED_STRATEGY=07:00
SCHED_CREATE=08:00
SCHED_QA=09:00
SCHED_PUBLISH_1=10:00
SCHED_PUBLISH_2=13:00
SCHED_PUBLISH_3=17:00
SCHED_ANALYTICS=20:00
SCHED_OPTIMIZE=21:00

# --- AI providers ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1
IMAGE_PROVIDER=auto
TTS_PROVIDER=auto

# --- Social app credentials (OAuth) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000

# --- Brand ---
BRAND_NAME=MindGrove Academy
BRAND_INDUSTRY=Developmental Psychology Education
BRAND_COLORS=#4F46E5,#7C3AED,#0EA5E9,#F59E0B,#10B981
